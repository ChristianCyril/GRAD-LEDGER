generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum ClearanceStatus {
  Cleared
  Not_Cleared
}

enum CertificateStatus {
  Issued
  Not_Issued
}

enum CertificateRecordStatus {
  Pending
  Issued
  Revoked
}

enum UserRole {
  admin
  student
}

enum Action {
  issued
  revoked
  batch_issued
  credentials_resent
}

// --- Core Models ---

model User {
  user_id       String    @id @default(uuid())
  email         String    @unique
  password      String
  role          UserRole
  refresh_token RefreshToken[]
  first_name    String
  last_name     String
  created_at    DateTime  @default(now())

  // One-to-One Subtype relations
  student       Student?
  admin         Admin?
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String
  user_id    String
  user       User @relation(fields:[user_id], references:[user_id], onDelete: Cascade)
}

model Student {
  // Shared Primary Key: This is both the PK and the FK to User
  user_id          String           @id
  user             User             @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  student_id       String           @unique 
  phone_number     String?
  nationality      String?
  date_of_birth    DateTime?
  created_at       DateTime         @default(now())

  academic_records AcademicRecord[]
}

model Admin {
  user_id       String        @id
  user          User          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  activity_logs ActivityLog[]
}


model Faculty {
  faculty_id  String       @id @default(uuid())
  name        String
  departments Department[]
}

model Department {
  department_id String      @id @default(uuid())
  name          String
  faculty_id    String
  faculty       Faculty     @relation(fields: [faculty_id], references: [faculty_id])
  programmes    Programme[]
}

model Programme {
  programme_id     String           @id @default(uuid())
  name             String
  department_id    String
  department       Department       @relation(fields: [department_id], references: [department_id])
  academic_records AcademicRecord[]
}



model AcademicRecord {
  record_id          String           @id @default(uuid())
  student_user_id    String           
  programme_id       String
  entry_year         Int
  graduation_year    Int
  final_gpa          Float?
  clearance_status   ClearanceStatus  @default(Not_Cleared)
  certificate_status CertificateStatus @default(Not_Issued)
  student            Student          @relation(fields: [student_user_id], references: [user_id])
  programme          Programme        @relation(fields: [programme_id], references: [programme_id])
  certificate        Certificate?
}

model Certificate {
  cert_id         String                  @id @default(uuid())
  record_id       String                  @unique 
  hash            String                  @unique 
  tx_hash         String?                 @unique 
  status          CertificateRecordStatus @default(Pending)
  issued_at       DateTime                @default(now())
  revoked_at      DateTime?
  academic_record AcademicRecord          @relation(fields: [record_id], references: [record_id])
}

model ActivityLog {
  log_id      String   @id @default(uuid())
  admin_id    String   // Foreign key to the Admin (user_id)
  action      Action
  target_id   String   // Soft-link to the entity being acted upon (Student ID or Cert ID)
  reason      String?
  timestamp   DateTime @default(now())
  admin       Admin    @relation(fields: [admin_id], references: [user_id])
}
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────

enum OrgType {
  UNIVERSITY
  COLLEGE
  PROFESSIONAL_BODY
  TRAINING_INSTITUTE
}

enum OrgStatus {
  PENDING
  APPROVED
  REJECTED
  DISABLED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum CertStatus {
  PENDING
  CONFIRMED
  FAILED
  REVOKED
}

enum AuditAction {
  CERTIFICATE_ISSUED
  CERTIFICATE_REVOKED
  ADMIN_CREATED
  ADMIN_ENABLED
  ADMIN_DISABLED
  ORG_PROFILE_UPDATED
}

// Covers all roles that can hold a session (students excluded — no portal)
enum UserRole {
  SUPER_ADMIN
  ORG_SUPER_ADMIN
  ORG_ADMIN
}

// Covers the two org-level roles that issue certificates and appear in audit logs
enum OrgUserRole {
  ORG_SUPER_ADMIN
  ORG_ADMIN
}

// ─── MODELS ──────────────────────────────────────────────

// Platform-level administrator. Only one exists in the system.
model SuperAdmin {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  created_at    DateTime @default(now())
}

// An organisation registered on the platform.
model Organisation {
  id               String    @id @default(uuid())
  name             String
  code             String    @unique  // short identifier e.g. "UY1" used in org URLs and emails
  type             OrgType
  country          String
  city             String
  website          String?
  logo_url         String?
  official_email   String    @unique
  phone            String
  address          String
  status           OrgStatus @default(PENDING)
  rejection_reason String?
  disabled_at      DateTime?

  doc_incorporation    String?
  doc_letter_of_intent String?
  doc_accreditation    String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  users        OrgUser[]
  students     Student[]
  certificates Certificate[]
  audit_logs   AuditLog[]
}

// Unified model for both Org Super Admin and Org Admin.
// The role field determines capabilities — no separate tables needed.
// Certificate and AuditLog both use a single clean FK to this model.
model OrgUser {
  id            String      @id @default(uuid())
  org_id        String
  role          OrgUserRole
  full_name     String
  job_title     String
  email         String      @unique
  phone         String
  password_hash String
  status        UserStatus  @default(ACTIVE)

  password_reset_token   String?
  password_reset_expires DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  organisation Organisation  @relation(fields: [org_id], references: [id])
  certificates Certificate[]
  audit_logs   AuditLog[]
}

// A student who has been issued a certificate.
// No authentication — students receive credentials by email only.
// Scoped to an organisation: same real person at two orgs = two Student records.
model Student {
  id        String @id @default(uuid())
  org_id    String
  full_name String
  matricule String
  email     String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  organisation Organisation  @relation(fields: [org_id], references: [id])
  certificates Certificate[]

  @@unique([org_id, matricule])
  @@unique([org_id, email])
}

// A certificate issued to a student by an organisation.
model Certificate {
  id         String @id @default(uuid())
  org_id     String
  student_id String
  issued_by_id String

  // Academic details specific to this certificate
  department         String
  program            String
  year_of_entry      Int
  year_of_graduation Int
  gpa                Float

  // Blockchain & storage
  certificate_hash String     @unique
  cloudinary_url   String
  tx_hash          String?

  status        CertStatus @default(PENDING)
  revoke_reason String?
  issued_at     DateTime   @default(now())
  revoked_at    DateTime?

  // Relations
  organisation Organisation @relation(fields: [org_id], references: [id])
  student      Student      @relation(fields: [student_id], references: [id])
  issued_by    OrgUser      @relation(fields: [issued_by_id], references: [id])

  // Prevents the same organisation issuing duplicate credentials for the
  // same student, program, and graduation year. Two different PDFs for
  // the same student/program/year would pass the hash check but fail here.
  @@unique([student_id, org_id, program, year_of_graduation])

  @@index([org_id])
  @@index([student_id])
  @@index([status])
}

// Immutable record of every significant action performed within an org.
model AuditLog {
  id          String      @id @default(uuid())
  org_id      String
  actor_id    String
  action      AuditAction
  description String
  created_at  DateTime    @default(now())

  // Relations
  organisation Organisation @relation(fields: [org_id], references: [id])
  actor        OrgUser      @relation(fields: [actor_id], references: [id])

  @@index([org_id])
  @@index([created_at])
}

// One row per active session. Stores a hashed refresh token.
// Supports multiple concurrent sessions per user.
model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  user_id    String
  user_role  UserRole
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([user_id, user_role])
}
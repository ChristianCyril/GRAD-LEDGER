
generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum ClearanceStatus {
  Cleared
  Not_Cleared
}

enum CertificateStatus {
  Issued
  Not_Issued
}

enum CertificateRecordStatus {
  Pending
  Issued
  Revoked
}

enum UserRole {
  admin
  student
}

enum Action {
  issued
  revoke
}

model Student {
  student_id        String             @id
  first_name        String
  last_name         String
  phone_number      String?
  nationality       String?
  date_of_birth     DateTime?
  academic_records  AcademicRecord[]
  portal_credential PortalCredential?
  created_at        DateTime           @default(now())
}

model Faculty {
  faculty_id  String       @id
  name        String
  departments Department[]
}

model Department {
  department_id String      @id
  name          String
  faculty_id    String
  faculty       Faculty     @relation(fields: [faculty_id], references: [faculty_id])
  programmes    Programme[]
}

model Programme {
  programme_id     String           @id
  name             String
  department_id    String
  department       Department       @relation(fields: [department_id], references: [department_id])
  academic_records AcademicRecord[]
}

model AcademicRecord {
  record_id          String            @id
  student_id         String
  programme_id       String
  entry_year         Int
  graduation_year    Int
  final_gpa          Float?
  clearance_status   ClearanceStatus   @default(Not_Cleared)
  certificate_status CertificateStatus @default(Not_Issued)
  student            Student           @relation(fields: [student_id], references: [student_id])
  programme          Programme         @relation(fields: [programme_id], references: [programme_id])
  certificates       Certificate?
}

model Admin {
  admin_id         String    @id
  name             String
  email            String    @unique
  password         String
  refresh_token    String?
  role       UserRole @default(admin)
  created_at       DateTime  @default(now())
  activity_logs ActivityLog[]
}

model Certificate {
  cert_id         String                  @id
  record_id       String             @unique
  hash            String  @unique
  tx_hash   String? @unique
  status          CertificateRecordStatus @default(Pending)
  issued_at       DateTime                @default(now())
  revoked_at      DateTime?
  academic_record AcademicRecord          @relation(fields: [record_id], references: [record_id])
}

model PortalCredential {
  email            String  @unique
  credential_id    Int       @id @default(autoincrement())
  student_id       String    @unique
  password         String
  role             UserRole @default(student)
  refresh_token    String?
  created_at       DateTime  @default(now())
  student          Student   @relation(fields: [student_id], references: [student_id])
}

model ActivityLog {
  log_id      String   @id @default(uuid())
  admin_id    String
  action      Action  
  target_id   String   
  reason      String?
  timestamp   DateTime @default(now())
  admin       Admin    @relation(fields: [admin_id], references: [admin_id])
}
